{
  "name": "open-task",
  "version": "0.1.2-alpha",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "worker": "tsx server/worker.ts",
    "db:migrate": "tsx server/migrate.ts",
    "db:seed": "tsx server/seed.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "start": "tsx server/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "case:check": "bash scripts/release-case.sh",
    "docs:build": "tsx scripts/render-docs.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "argon2": "0.45.1",
    "d3-force": "3.0.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "lucide-react": "1.43.0",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/d3-force": "3.0.10",
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "fast-uri@^3": "3.1.8",
    "fast-uri@^4": "4.1.5",
    "ip-address": "10.7.1"
  }
}
